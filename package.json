{
  "name": "lonelysky-engine",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "description": "A seeded procedural universe generator with an optional Three.js renderer, streaming, gravity and continuous collision.",
  "homepage": "https://lonelysky.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ares-X/LonelySky-Engine.git"
  },
  "keywords": [
    "universe",
    "procedural-generation",
    "threejs",
    "space",
    "webgl"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.js",
    "./coordinates": "./src/coordinates.js",
    "./random": "./src/random.js",
    "./gravity": "./src/gravity.js",
    "./collision": "./src/collision.js",
    "./orbits": "./src/orbits.js",
    "./generator": "./src/generator.js",
    "./cosmic-structures": "./src/cosmic-structures.js",
    "./streaming": "./src/streaming.js",
    "./three": "./src/three.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:render": "node --test tests/render/*.test.mjs",
    "dev": "node examples/serve.mjs"
  },
  "engines": {
    "node": ">=22.13"
  }
}
